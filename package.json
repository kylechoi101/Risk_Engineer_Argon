{
  "name": "sf-waterfront-disaster-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bake:placeholder": "node tools/bake_district.mjs --placeholder",
    "bake:real": "python3 tools/fetch_real_data.py && node tools/bake_district.mjs",
    "bake:damage": "cd backend && uv run python scripts/bake_contract.py",
    "demo": "npm run build && cd backend && uv run fastapi run --port 8000"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
